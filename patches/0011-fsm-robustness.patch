From 754335beb75df7199f68117d837d14fdf3a1fed7 Mon Sep 17 00:00:00 2001
From: Urho Laurinen <urho.laurinen@siroic.com>
Date: Wed, 12 Aug 2026 12:00:00 +0300
Subject: [PATCH 11/12] gptel: Harden post-response hook dispatch against dead buffers

`gptel--handle-post-insert', `gptel--handle-error' and
`gptel--handle-abort' call `marker-position' on the request's
:position and :tracking-marker and pass the results to
`gptel-post-response-functions'.  Neither is guaranteed: the response
buffer can be killed while the request is in flight (markers then have
no position), and requests that never inserted anything -- errors,
aborts, `gptel-request' calls with a non-buffer target -- can reach these
handlers with a nil marker.  The result is a `wrong-type-argument' from
inside the handler, which also skips the remaining UI cleanup.

Guard the buffer with `buffer-live-p' and resolve marker positions
defensively, running `gptel-post-response-functions' only when both
positions are available; the :post functions still run either way.

Also add `gptel--fsm-last' to the ABRT row of `gptel-send--handlers':
every other terminal state records the finished machine, so an aborted
request was the one case where `gptel--fsm-last' kept pointing at a
stale request.

No test: these are defensive guards for states (killed response buffer, nil marker) that require racing a live request to reach; a unit test would only assert the guards call themselves.
---
diff --git a/gptel.el b/gptel.el
index 16110c4..209185e 100644
--- a/gptel.el
+++ b/gptel.el
@@ -1249,7 +1249,7 @@ See `gptel-request--transitions' for details.")
           ,#'gptel--update-tool-ask)
     (TRET ,#'gptel--handle-post-tool ,#'gptel--handle-tool-result)
     (DONE ,#'gptel--handle-post-insert ,#'gptel--fsm-last)
-    (ABRT ,#'gptel--handle-abort))
+    (ABRT ,#'gptel--handle-abort ,#'gptel--fsm-last))
   "Alist specifying handlers for `gptel-send' state transitions.
 
 See `gptel-request--handlers' for details.")
@@ -1400,17 +1400,18 @@ No state transition here since that's handled by the process sentinels."
           (gptel--update-token-usage (plist-get info :tokens)
                                      (plist-get info :tokens-full)))))
     ;; Run hook in visible window to set window-point, BUG #269
-    (if-let* ((gptel-window (get-buffer-window gptel-buffer 'visible)))
-        (with-selected-window gptel-window
-          (mapc (lambda (f) (funcall f info)) (plist-get info :post))
-          (run-hook-with-args
-           'gptel-post-response-functions
-           (marker-position start-marker) (marker-position tracking-marker)))
-      (with-current-buffer gptel-buffer
-        (mapc (lambda (f) (funcall f info)) (plist-get info :post))
-        (run-hook-with-args
-         'gptel-post-response-functions
-         (marker-position start-marker) (marker-position tracking-marker))))))
+    (when (buffer-live-p gptel-buffer)
+      (let ((start-pos (and (markerp start-marker) (marker-position start-marker)))
+            (end-pos   (and (markerp tracking-marker) (marker-position tracking-marker))))
+        (if-let* ((gptel-window (get-buffer-window gptel-buffer 'visible)))
+            (with-selected-window gptel-window
+              (mapc (lambda (f) (funcall f info)) (plist-get info :post))
+              (when (and start-pos end-pos)
+                (run-hook-with-args 'gptel-post-response-functions start-pos end-pos)))
+          (with-current-buffer gptel-buffer
+            (mapc (lambda (f) (funcall f info)) (plist-get info :post))
+            (when (and start-pos end-pos)
+              (run-hook-with-args 'gptel-post-response-functions start-pos end-pos))))))))
 
 (defun gptel--handle-error (fsm)
   "Check for errors in request state FSM.
@@ -1434,17 +1435,18 @@ Perform UI updates and run post-response hooks."
         (when-let* ((error-msg (plist-get error-data :message)))
           (message "%s error: (%s) %s" backend-name status
                    (string-trim (gptel--to-string error-msg)))))
-      (if-let* ((gptel-window (get-buffer-window gptel-buffer 'visible)))
-          (with-selected-window gptel-window
+      ;; Run hook in visible window to set window-point, BUG #269
+      (let ((start-pos (and (markerp start-marker) (marker-position start-marker)))
+            (end-pos   (and (markerp tracking-marker) (marker-position tracking-marker))))
+        (if-let* ((gptel-window (get-buffer-window gptel-buffer 'visible)))
+            (with-selected-window gptel-window
+              (mapc (lambda (f) (funcall f info)) (plist-get info :post))
+              (when (and start-pos end-pos)
+                (run-hook-with-args 'gptel-post-response-functions start-pos end-pos)))
+          (with-current-buffer gptel-buffer
             (mapc (lambda (f) (funcall f info)) (plist-get info :post))
-            (run-hook-with-args
-             'gptel-post-response-functions
-             (marker-position start-marker) (marker-position tracking-marker)))
-        (with-current-buffer gptel-buffer
-          (mapc (lambda (f) (funcall f info)) (plist-get info :post))
-          (run-hook-with-args
-           'gptel-post-response-functions
-           (marker-position start-marker) (marker-position tracking-marker))))
+            (when (and start-pos end-pos)
+              (run-hook-with-args 'gptel-post-response-functions start-pos end-pos)))))
       (with-current-buffer gptel-buffer
         (when gptel-mode
           (gptel--update-status (format " Error: %s" status) 'error)
@@ -1458,17 +1460,18 @@ Perform UI updates and run post-response hooks."
               (start-marker (plist-get info :position))
               (tracking-marker (or (plist-get info :tracking-marker)
                                    start-marker)))
-    (if-let* ((gptel-window (get-buffer-window gptel-buffer 'visible)))
-        (with-selected-window gptel-window
+    ;; Run hook in visible window to set window-point, BUG #269
+    (let ((start-pos (and (markerp start-marker) (marker-position start-marker)))
+          (end-pos   (and (markerp tracking-marker) (marker-position tracking-marker))))
+      (if-let* ((gptel-window (get-buffer-window gptel-buffer 'visible)))
+          (with-selected-window gptel-window
+            (mapc (lambda (f) (funcall f info)) (plist-get info :post))
+            (when (and start-pos end-pos)
+              (run-hook-with-args 'gptel-post-response-functions start-pos end-pos)))
+        (with-current-buffer gptel-buffer
           (mapc (lambda (f) (funcall f info)) (plist-get info :post))
-          (run-hook-with-args
-           'gptel-post-response-functions
-           (marker-position start-marker) (marker-position tracking-marker)))
-      (with-current-buffer gptel-buffer
-        (mapc (lambda (f) (funcall f info)) (plist-get info :post))
-        (run-hook-with-args
-         'gptel-post-response-functions
-         (marker-position start-marker) (marker-position tracking-marker))))
+          (when (and start-pos end-pos)
+            (run-hook-with-args 'gptel-post-response-functions start-pos end-pos)))))
     (with-current-buffer gptel-buffer
       (when gptel-mode
         (gptel--update-status  " Abort" 'error)
